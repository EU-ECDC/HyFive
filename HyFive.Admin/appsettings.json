{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "HandhygieneConnection": "Host=localhost; Port=5433; Database=handhygiene ; Username=handhygiene; Password=1899; SSL Mode=Disable"
  },
  "HandhygieneHelseIdKonfigurasjon": {
    "ExcludeStaticAssetsFromProtection": "false",
    "CacheStaticAssets": "false"
  },
  "HelseIdWebKonfigurasjon": {
    "AuthUse": "false",
    "Authority": "https://helseid-sts.test.nhn.no/",
    "ClientId": "",
    "ClientSecret": ""
  },
  "DataProtectionConfig": {
    "Enabled": "true",
    "ConnectionString": "Server=.;Database=Handhygiene;Trusted_Connection=True;",
    "Schema": "DataProtection",
    "TableName": "Keys"
  },
  "HealthCheckConfig": {
    "AddDatabaseHealthChecks": "false"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.AzureBlobStorage"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "IMPORTANT_MESSAGE": "The WriteTo array below should _only_ be modified in the respective environments due to transformation in Azure and Octopus Deploy",
    "WriteTo": [],
    "Properties": {
      "Application": "HyFive.Admin"
    }
  }
}

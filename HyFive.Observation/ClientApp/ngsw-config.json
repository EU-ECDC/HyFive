{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/",
  "navigationRequestStrategy": "freshness",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "lazy",
      "resources": {
        "files": [
          "/favicon.ico",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js",
          "/*.svg"

        ]
      },
      "updateMode": "lazy"
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": [
          "/assets/**",
          "/*.(eot|svg|cur|jpg|png|webp|gif|otf|ttf|woff|woff2|ani)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "facility",
      "urls": [
        "api/v1/facility"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "timeout": "0u",
        "maxAge": "1d",
        "maxSize": 10
      }
    },
    {
      "name": "codeWork",
      "urls": [
        "api/v1/fiveindications/activitytypes",
        "api/v1/fiveindications/indicationTypes",
        "api/v1/handjewelry/handJewelryTypes",
        "api/v1/protectiveEquipment",
        "api/v1/glove/gloveWithIndicationType",
        "api/v1/glove/glovewithoutindicationtype",
        "api/v1/glove/handhygieneaftergloveusetype"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "timeout": "0u",
        "maxAge": "1d",
        "maxSize": 10
      }
    }
  ]
}

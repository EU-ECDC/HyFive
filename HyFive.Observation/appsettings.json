{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "ConnectionStrings": {
    "HandhygieneConnection": "Host=localhost; Port=5433; Database=handhygiene; Username=handhygiene; Password=1899; SSL Mode=Disable"
  },
  "HandhygieneConfiguration": {
    "ExcludeStaticAssetsFromProtection": "false",
    "CacheStaticAssets": "false"
  },
  "OpenIdConnect": {
    "AuthUse": "true",
    "RequireHttpsMetadata": "true",
    "Authority": "",
    "ClientId": "",
    "ClientSecret": "",
    "SaveTokens": "false"
  },
  "RedirectPagesSettings": {
    "RedirectLogInUri": "https://localhost:44340/signin-oidc",
    "RedirectLogOutUri": "https://localhost:44340/",
    "LoggedOut": "/",
    "LoggedIn": "/dashboard"
  },
  "DataProtectionConfig": {
    "Enabled": "true",
    "ConnectionString": "Server=.;Database=Handhygiene;Trusted_Connection=True;",
    "Schema": "DataProtection",
    "TableName": "Keys"
  },
  "HealthCheckConfig": {
    "AddDatabaseHealthChecks": "false"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.AzureBlobStorage"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "VIKTIGMELDING": "WriteTo-arrayet under skal _kun_ modifiseres i de respektive milj�ene av hensyn til transformering i Azure og Ocotopus Deploy ",
    "WriteTo": [],
    "Properties": {
      "Application": "HyFive.Observation"
    }
  },
  "ClaimTypes": {
    "RoleClaimType": "http://ecdc/role/atom",
    "EnvironmentAccessClaimType": "http://ecdc/supo/env",
    "DisplayNameClaimType": "http://ecdc/displayName",
    "UniqueIdentifierClaimType": "http://ecdc/guid"
  },
  "Security": {

    "JwtBearer": {
      "Authority": "https://zfs.ecdc.azure/adfs",
      "ValidIssuer": "http://zfs.ecdc.azure/adfs/services/trust",
      "Audience": "https://localhost/survportal/api/notificationmanagement"
    },

    "EnvironmentAccess": "DEV"

  }
}
